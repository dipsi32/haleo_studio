# Copy to .env.staging (git-ignored) for a local staging build, or set these
# as environment variables on your staging host. Never put the production
# values here: the build refuses to run if it sees the production project.
VITE_APP_ENV="staging"
VITE_SUPABASE_URL="https://<staging-project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<staging publishable (anon) key>"
VITE_SUPABASE_PROJECT_ID="<staging-project-ref>"
